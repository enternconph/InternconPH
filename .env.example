# ==============================================================================
# InternConPH Frontend Environment Variables (.env.example)
# Place these environment variables in your Vercel Project Settings -> Environment Variables.
# ==============================================================================

# Vercel rewrites /api to the Render backend, so VITE_API_URL can remain empty in production.
# Leave blank or set only if you are calling an external absolute API URL.
VITE_API_URL=

# Render Backend URL for Socket.IO WebSocket connections.
# Vercel cannot proxy persistent WebSockets, so the client connects directly to Render.
# Example: https://internconph-api.onrender.com
VITE_SOCKET_URL=https://YOUR-RENDER-URL.onrender.com
