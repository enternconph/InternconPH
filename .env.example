# ==========================================
# InternConPH Frontend Configuration (.env)
# ==========================================

# Base URL for the Backend API
# In local development using the Vite proxy, leave empty to default to '/api'
# In production, set to your backend deployment origin (e.g., https://api.interncon.ph)
VITE_API_URL=

# Socket.IO Server URL
# In local development, leave empty to default to current origin
# In production, set to your backend Socket.IO origin (e.g., https://api.interncon.ph)
VITE_SOCKET_URL=
