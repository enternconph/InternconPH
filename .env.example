# ==============================================================================
# InternConPH Frontend Environment Variables (.env.example)
# Place these environment variables in your Vercel Project Settings -> Environment Variables.
# NOTE: In Vite, variables must start with VITE_ to be exposed to the browser.
# ==============================================================================

# Render Backend URL for REST API requests (Must include https:// and NO trailing slash)
# Example: https://internconph-api.onrender.com
VITE_API_URL=https://your-backend-app.onrender.com

# Render Backend URL for Socket.IO Realtime WebSocket connections
# Example: https://internconph-api.onrender.com
VITE_SOCKET_URL=https://your-backend-app.onrender.com
