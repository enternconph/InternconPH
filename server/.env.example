# ==========================================
# InternConPH Backend Configuration (.env)
# ==========================================

# Server Port (Hosting platform default if provided)
PORT=3000
NODE_ENV=development

# MySQL Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=interncon_ph
DB_USER=root
DB_PASSWORD=

# JWT Secret for Auth Token Sign & Verify
JWT_SECRET=your_secure_random_jwt_secret_change_in_production

# Allowed CORS Origins (comma-separated for multiple origins)
# Example: http://localhost:5173,https://interncon.ph,https://app.interncon.ph
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
