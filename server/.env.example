# ==============================================================================
# InternConPH Backend Environment Variables (server/.env.example)
# Configure these variables in Render Dashboard -> Environment Variables.
# ==============================================================================

# Server Environment & Port
PORT=3000
NODE_ENV=production

# Cross-Origin Allowed Origins (comma-separated list of your frontend URLs)
# Include your Vercel deployment URL and local development port.
CLIENT_URL=https://YOUR-FRONTEND.vercel.app,http://localhost:5173

# Cryptographic Secret for JWTs and Session fallback
JWT_SECRET=your_super_secret_jwt_random_key_min_32_characters_here

# Cloud MySQL Database Configuration (e.g. Aiven, TiDB Cloud, PlanetScale)
DB_HOST=your-mysql-host.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASS=your_database_password
DB_NAME=defaultdb

# Database Connection Pool Limit (free tiers have tight connection caps)
DB_POOL_LIMIT=5

# SSL Configuration for Cloud Databases
# Set DB_SSL=true for Aiven, TiDB, or any cloud MySQL that requires TLS/SSL
DB_SSL=true
# Optional: If your cloud database provider provides a custom CA certificate, paste it here:
# DB_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Session Lifetimes
SESSION_INACTIVITY_TIMEOUT_MINUTES=120
SESSION_ABSOLUTE_LIFETIME_DAYS=7

# Persistent Cloud Storage (Optional Cloudinary setup for persistent uploads on free tier)
# If provided, file uploads go to Cloudinary; otherwise files save to server/uploads locally.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
