# ==============================================================================
# InternConPH Backend Environment Variables (server/.env.example)
# Place these in Render Dashboard -> Service -> Environment Variables
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=3000

# Database Configuration (Remote MySQL / Aiven / TiDB / Render MySQL)
DB_HOST=your-remote-db-host.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASS=your_db_password
DB_NAME=interncon_ph
# Set DB_SSL=true if using cloud databases requiring SSL (e.g. Aiven, TiDB)
DB_SSL=true

# Security
JWT_SECRET=internconph_jwt_secret_2026_super_key

# CORS Allowed Origins
# Your Vercel frontend URL (e.g. https://internconph.vercel.app)
FRONTEND_URL=https://your-frontend-app.vercel.app
ALLOWED_ORIGINS=https://your-frontend-app.vercel.app

# Google Meet REST API v2 OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# Cloudinary Cloud Storage (Optional for persistent cloud file uploads)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
