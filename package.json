{
  "name": "internconph-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @internconph/web",
    "dev:api": "npm run dev -w @internconph/api",
    "dev:desktop": "npm run dev -w @internconph/desktop",
    "dev:mobile": "npm run start -w @internconph/mobile",
    "dev:all": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "build:web": "npm run build -w @internconph/web",
    "build:desktop": "npm run build -w @internconph/desktop",
    "cap:sync": "npm run cap:sync -w @internconph/web"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "wait-on": "^9.5.1"
  }
}
